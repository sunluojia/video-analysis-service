# 运行配置（除服务凭据外均有默认值，按需覆盖）
VA_DATABASE_URL=postgresql+asyncpg://video:video@localhost:5432/video_analysis
# 与调度中心共用的 Redis 和 Dramatiq 命名空间
VA_REDIS_URL=redis://localhost:6379/0
VA_QUEUE_NAMESPACE=dramatiq
VA_WORK_ROOT=data/work
VA_ARTIFACT_RETENTION_HOURS=72

# 调度中心：本服务从这里下载原视频，并定期注册和心跳
VA_SCHEDULER_URL=http://localhost:8080
# 两个服务互相调用的服务凭据，不少于 16 位，与调度中心配置一致
VA_SERVICE_TOKEN=
# 调度中心访问本服务的地址和本实例的标识（默认主机名）
VA_PUBLIC_URL=http://localhost:8000
# VA_INSTANCE_ID=

# 按需备料与保护
VA_DOWNLOAD_SLOTS=4
VA_MEDIA_SLOTS=4
VA_THREAD_POOL_SIZE=4
VA_ADMISSION_FACTOR=2
VA_MEDIA_BACKLOG=50
VA_MIN_FREE_DISK_GB=10
VA_LISTEN_PER_VIDEO=2
VA_FRAME_COUNT=8
VA_AUDIO_SEGMENT_SECONDS=60

# 模型密钥：AI 配置里的“凭据引用”填写这里的变量名
OPENAI_API_KEY=

# 测试使用的独立测试库，测试会重建其中的表
# VA_TEST_DATABASE_URL=postgresql+asyncpg://video:video@localhost:55432/video_analysis_test
